{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "extractor_output",
 "type": "object",
 "properties": {
  "statements": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "review_id": {
      "type": "string"
     },
     "text_span": {
      "type": "string",
      "minLength": 1
     },
     "translation": {
      "type": [
       "string",
       "null"
      ]
     },
     "issue_phrase": {
      "type": "string",
      "minLength": 1
     },
     "location_phrase": {
      "type": "string",
      "minLength": 1
     },
     "statement_type": {
      "enum": [
       "Bug report",
       "Complaint",
       "Feature request",
       "Praise",
       "Question",
       "Comparison",
       "Other"
      ]
     },
     "sentiment": {
      "enum": [
       "Positive",
       "Negative",
       "Neutral",
       "Mixed"
      ]
     },
     "severity": {
      "enum": [
       "Blocker",
       "Major",
       "Minor",
       "Cosmetic",
       null
      ]
     },
     "ux_dimension": {
      "enum": [
       "Usability",
       "Reliability",
       "Performance",
       "Visual design",
       "Content and copy",
       "Functionality",
       "Trust and safety",
       "Value and pricing",
       "Support",
       "Accessibility"
      ]
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "required": [
     "review_id",
     "text_span",
     "issue_phrase",
     "location_phrase",
     "statement_type",
     "sentiment",
     "severity",
     "ux_dimension",
     "confidence"
    ],
    "additionalProperties": true
   }
  },
  "excluded": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "statements"
 ],
 "additionalProperties": true
}